# DOMjudge base URL to poll for team roster + IPs
DOMJUDGE_URL=http://10.10.220.112
# DOMjudge API basic-auth credentials
API_USER=api0
API_PASS=changeme
# VNC port on each team machine
VNC_PORT=5900
# websockify listen port (frontend connects here over ws://)
WS_PORT=6080
# port the app + /api/teams is served on
HTTP_PORT=8080
# how often to re-poll DOMjudge for team/IP changes, in ms
POLL_MS=5000
# VNC password sent to every target
VNC_PASSWORD=1234
